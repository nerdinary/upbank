<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Syne:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">

    <!-- sidebar -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="brand-logo">
          <svg fill="currentColor" viewBox="0 0 900 900">
            <path d="M782.78 435.5a113.87 113.87 0 0 0-9.47-43.75C747 332.2 692.2 302.46 626.68 312.24a175.72 175.72 0 0 0-32.46 8.07c-3.67-4.73-8.88-6.74-16.81-6.76h-39.22a10.73 10.73 0 0 0-10 7.23c-5.6 15.42-55.3 151.91-71.26 194.3-2.79 7.43-14 31.37-41.05 26.74a21.73 21.73 0 0 1-14.62-10 20.15 20.15 0 0 1-2.58-16.26l.68-2.36c1.59-5.56 3.39-11.86 5.53-17.51l62.48-164.91a10.57 10.57 0 0 0-9.88-14.31c-19.89 0-40.54 0-46.21-.05-9.87-.38-17.34 5.1-20.66 14.52-9.39 26.71-18.92 52.83-28.32 77.64-5.21 13.75-10.11 28.23-14.44 41-5.69 16.86-11.59 34.3-18.33 50.92-4.34 10.72-10.16 22.82-20.4 31.36-13.59 11.31-30.35 15.34-51.22 12.38-8-1.13-14.77-5.7-19.73-13.19-5.06-7.65-7.17-16.85-6.47-28.11.86-13.36 5.25-26.29 10.06-39.45 10.71-29.41 32.5-87.76 49-130.77a10.56 10.56 0 0 0-9.85-14.35H238.44a24.18 24.18 0 0 0-14.11 4c-9.25 6.15-21.38 17.75-35.45 31.2C169.47 372 145.42 395 122 410.19a10.56 10.56 0 0 0-.29 17.55c2.6 1.81 5 1.77 9.31 1a6.62 6.62 0 0 0 1.08-.2c6.6-1.35 21.23-5.05 53.88-13.41-9.3 23.51-18.73 48.72-23.44 75.8-5.74 32.93 2.4 63.7 23.54 89 34 40.68 89.92 42.26 127.55 26.54 14.17-5.92 25.05-15.56 33.94-25.12 17.75 23.47 49.32 33.44 75.4 30.84l-7.06 19.07-2.77 7.48c-11.62 31.45-26.09 70.6-34 90.85-2.67 6.85-2 13.93 1.8 19.46s10.13 8.57 17.75 8.57l38.24-.29a10.47 10.47 0 0 0 10-7c6.21-17.31 15.44-42.92 24.74-68.75l9.3-25.79c10.11-28.08 19.1-53 22.88-63.63l9.15-25.6a118.05 118.05 0 0 0 13.18 13.1c31.85 26.84 68.92 37 110.18 30.15 35.24-5.84 65.5-20.38 89.94-43.24 38.86-36.33 57.87-80.43 56.48-131.07zm-78.54 13.34c-4.64 34.54-20.81 60.79-48.08 78-14.29 9-29.61 13.61-45.55 13.61h-.31c-25.16-.08-46.41-15.77-54.15-40a82 82 0 0 1-3-13.31c-.23-1.61-.32-3.25-.46-5.48l-.17-1.58a108.85 108.85 0 0 1 25.54-65.24c16.69-19.84 38.41-30.84 64.59-32.58 1.36-.09 2.72-.14 4.06-.14 22.12 0 40.69 12 50.94 33 5.78 11.79 8 23.14 6.59 33.72z"/>
          </svg>
        </div>
        <div class="brand-text">
          <div class="brand-name">Unofficial Up</div>
        </div>
      </div>

      <div class="sidebar-scroll">
        <div class="sidebar-label-row">
          <span class="sidebar-label">Accounts</span>
          <button id="balance-toggle-btn" class="balance-toggle-btn" title="Toggle balance visibility">
            <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" style="display:none;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
          </button>
        </div>

        <div class="account-list">
          <% accounts.forEach((account, index) => { %>
            <div class="card card-color-<%= (index % 5) + 1 %>" data-account-id="<%= account.id %>" data-ownership="<%= account.attributes.ownershipType %>">
              <div class="card-badge"><%= account.attributes.accountType.replace('_', ' ') %></div>
              <div class="card-name"><%= account.attributes.displayName %></div>
              <div class="card-balance-row">
                <span class="balance-amount"><%= parseFloat(account.attributes.balance.value).toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                <span class="balance-currency"><%= account.attributes.balance.currencyCode %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="sidebar-footer">
        <a href="/logout" class="logout-link">Sign out</a>
      </div>
    </aside>

    <!-- main -->
    <main>
      <div id="empty-state" class="empty-state">
        <p class="empty-eyebrow">Up Web</p>
        <p class="empty-headline">Select an account<br>to view <em>transactions</em></p>
      </div>

      <section id="transactions-section" style="display:none;">
        <div class="tx-header">
          <h2 id="transactions-heading" class="tx-title"></h2>
          <div class="filter-bar">
            <select id="filter-status" class="filter-select">
              <option value="">All statuses</option>
              <option value="SETTLED">Settled</option>
              <option value="HELD">Pending</option>
            </select>
            <input type="date" id="filter-since" class="filter-input" title="From date">
            <input type="date" id="filter-until" class="filter-input" title="To date">
            <button id="apply-filters-btn" class="filter-btn filter-btn-primary">Filter</button>
            <button id="clear-filters-btn" class="filter-btn filter-btn-secondary">Clear</button>
          </div>
        </div>

        <div id="transaction-list" class="transaction-list"></div>

        <div id="load-more-container" style="display:none; text-align:center; margin-top:1.5rem; padding:0.5rem 0 1rem;">
          <button id="load-more-btn" class="load-more-btn">Load more</button>
        </div>
      </section>
    </main>

  </div><!-- /.app -->

  <div id="toast-container"></div>

  <div id="transaction-details-panel" class="slide-out-panel">
    <div id="panel-content" class="panel-content"></div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const mainContent = document.querySelector('main');
      const emptyState = document.getElementById('empty-state');
      const accountCards = document.querySelectorAll('.card[data-account-id]');
      const transactionsSection = document.getElementById('transactions-section');
      const transactionsHeading = document.getElementById('transactions-heading');
      const transactionList = document.getElementById('transaction-list');
      const transactionDetailsPanel = document.getElementById('transaction-details-panel');
      const panelContent = document.getElementById('panel-content');

      let transactionsData = [];
      let categoryMap = {};
      let currentAccountId = null;
      let currentAccountName = null;
      let currentAccountIsJoint = false;
      let nextPageCursor = null;

      const loadMoreContainer = document.getElementById('load-more-container');
      const loadMoreBtn = document.getElementById('load-more-btn');

      // ── helpers ──────────────────────────────────────────────────────────

      function handleFetchError(response) {
        if (response.status === 401) {
          window.location.href = '/?error=session_expired';
          return true;
        }
        return false;
      }

      function fmt(value) {
        return parseFloat(value).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function formatAmount(value) {
        if (value.startsWith('-')) {
          return { text: `-$${fmt(value.substring(1))}`, cls: 'debit' };
        }
        return { text: `+$${fmt(value)}`, cls: 'credit' };
      }

      // ── load transactions ─────────────────────────────────────────────────

      async function loadTransactions(accountId, filters = {}) {
        const params = new URLSearchParams();
        if (filters.status) params.set('status', filters.status);
        if (filters.since)  params.set('since', new Date(filters.since).toISOString());
        if (filters.until)  params.set('until', new Date(filters.until + 'T23:59:59').toISOString());

        const response = await fetch(`/api/accounts/${accountId}/transactions?${params.toString()}`);
        if (handleFetchError(response)) return null;
        return response.json();
      }

      async function fetchAndRenderTransactions(accountId, filters = {}) {
        transactionList.innerHTML = '<p class="loading-text">Loading…</p>';
        emptyState.style.display = 'none';
        transactionsSection.style.display = 'block';

        const data = await loadTransactions(accountId, filters);
        if (!data) return;

        transactionsData = data.transactions;
        categoryMap = data.categoryMap || {};
        nextPageCursor = data.nextPage || null;
        renderTransactions(transactionsData);
        loadMoreContainer.style.display = nextPageCursor ? 'block' : 'none';
      }

      // ── render transaction list ───────────────────────────────────────────

      function renderTransactions(transactions) {
        transactionList.innerHTML = '';

        if (!transactions.length) {
          transactionList.innerHTML = '<p class="loading-text">No transactions found.</p>';
          return;
        }

        const grouped = transactions.reduce((groups, tx) => {
          const date = new Date(tx.attributes.createdAt).toDateString();
          if (!groups[date]) groups[date] = [];
          groups[date].push(tx);
          return groups;
        }, {});

        for (const date in grouped) {
          const header = document.createElement('div');
          header.classList.add('transaction-date-header');
          header.textContent = date;
          transactionList.appendChild(header);
          grouped[date].forEach(tx => transactionList.appendChild(buildTransactionItem(tx)));
        }
      }

      function buildTransactionItem(tx) {
        const item = document.createElement('div');
        item.classList.add('transaction-item');
        item.dataset.transactionId = tx.id;

        const icon = document.createElement('div');
        icon.classList.add('transaction-icon');
        icon.innerHTML = `<svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.43359 24.204C13.064 24.2238 17.6894 24.2486 22.3198 24.2684C22.2553 20.7337 22.1958 16.6486 22.1314 13.1138C17.7191 13.0494 13.3019 12.98 8.88969 12.9156C8.74096 14.0112 8.6666 15.1118 8.68147 16.2173L8.43359 24.204Z" stroke="currentColor" stroke-width="1.3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M10.2672 12.8908C10.2672 11.4878 10.2176 9.89145 10.6737 8.63222C10.9514 7.86875 11.5165 7.22921 12.1808 6.75824C13.326 5.95015 14.7737 5.62296 16.1766 5.71716C16.8558 5.76177 17.54 5.9006 18.12 6.25258C18.9231 6.73347 19.4586 7.56634 19.761 8.44879C20.0634 9.33124 20.2419 10.2682 20.3311 11.2002C20.3906 11.7902 20.4203 12.2116 20.4203 12.8015" stroke="currentColor" stroke-width="1.3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18.508 12.8114C18.508 11.7257 18.3642 10.878 18.0817 9.83192C17.9131 9.21222 17.6652 8.56278 17.1348 8.19096C16.8125 7.96291 16.4209 7.86376 16.0342 7.7894C15.3104 7.65554 14.5072 7.62084 13.8826 8.00753C13.4364 8.28516 13.02 8.67186 12.7919 9.13788C12.2069 10.3227 12.1524 11.5621 12.1821 12.9156" stroke="currentColor" stroke-width="1.3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15.7259 16.6685C15.7904 18.1111 15.721 19.5637 15.5078 20.9915" stroke="currentColor" stroke-width="1.3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;

        const details = document.createElement('div');
        details.classList.add('transaction-details');

        const desc = document.createElement('p');
        desc.classList.add('transaction-description');
        desc.textContent = tx.attributes.description;

        const meta = [];
        meta.push(new Date(tx.attributes.createdAt).toLocaleTimeString());
        if (tx.attributes.message) meta.push(tx.attributes.message);
        const catId = tx.relationships?.category?.data?.id;
        if (catId && categoryMap[catId]) meta.push(categoryMap[catId]);

        const subtext = document.createElement('div');
        subtext.classList.add('transaction-status');
        subtext.textContent = meta.join(' · ');

        details.appendChild(desc);
        details.appendChild(subtext);

        if (currentAccountIsJoint && tx.attributes.performingCustomer?.displayName) {
          const performer = document.createElement('div');
          performer.classList.add('transaction-performer');
          performer.textContent = tx.attributes.performingCustomer.displayName;
          details.appendChild(performer);
        }

        const tags = tx.relationships?.tags?.data?.map(t => t.id) ?? [];
        if (tags.length) {
          const tagRow = document.createElement('div');
          tagRow.classList.add('tag-row');
          tags.forEach(tag => {
            const chip = document.createElement('span');
            chip.classList.add('tag-chip');
            chip.textContent = tag;
            tagRow.appendChild(chip);
          });
          details.appendChild(tagRow);
        }

        const amountDiv = document.createElement('div');
        amountDiv.classList.add('transaction-amount');

        if (tx.attributes.roundUp) {
          const roundUp = document.createElement('div');
          roundUp.classList.add('round-up');
          roundUp.innerHTML = `<svg title="Round up: ${tx.attributes.roundUp.amount.value}" style="width:0.85rem;" width="36" height="36" viewBox="0 0 36 36" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M18 36C27.9409 36 36 27.9409 36 18C36 8.05908 27.9409 0 18 0C8.05908 0 0 8.05908 0 18C0 27.9409 8.05908 36 18 36ZM18 32C25.7319 32 32 25.7319 32 18C32 10.2681 25.7319 4 18 4C10.2681 4 4 10.2681 4 18C4 25.7319 10.2681 32 18 32Z" fill="#FF7A64"/><path d="M17.6536 7.1C17.8076 6.83333 18.1925 6.83333 18.3464 7.1L28.0459 23.9C28.1999 24.1667 28.0074 24.5 27.6995 24.5H8.30052C7.9926 24.5 7.80015 24.1667 7.95411 23.9L17.6536 7.1Z" fill="#FF7A64"/></svg>`;
          amountDiv.prepend(roundUp);
        }

        const { text, cls } = formatAmount(tx.attributes.amount.value);
        const amount = document.createElement('p');
        amount.classList.add('amount', cls);
        amount.textContent = text;
        amountDiv.appendChild(amount);

        if (tx.attributes.status === 'HELD') {
          const pending = document.createElement('div');
          pending.classList.add('status-badge', 'status-held');
          pending.textContent = 'Pending';
          amountDiv.appendChild(pending);
        }

        item.appendChild(icon);
        item.appendChild(details);
        item.appendChild(amountDiv);
        item.addEventListener('click', () => openPanel(tx));
        return item;
      }

      // ── detail panel ──────────────────────────────────────────────────────

      function openPanel(tx) {
        const { text: amountText } = formatAmount(tx.attributes.amount.value);
        const catId = tx.relationships?.category?.data?.id;
        const categoryName = catId && categoryMap[catId] ? categoryMap[catId] : null;
        const tags = tx.relationships?.tags?.data?.map(t => t.id) ?? [];

        const rows = [];

        rows.push(`<div class="panel-row"><span class="panel-label">${tx.attributes.amount.valueInBaseUnits < 0 ? 'Paid on' : 'Received'}</span><span>${new Date(tx.attributes.createdAt).toLocaleString()}</span></div>`);

        if (currentAccountIsJoint && tx.attributes.performingCustomer?.displayName) {
          rows.push(`<div class="panel-row"><span class="panel-label">Paid by</span><span class="performer-name">${tx.attributes.performingCustomer.displayName}</span></div>`);
        }

        if (tx.attributes.settledAt) {
          rows.push(`<div class="panel-row"><span class="panel-label">Settled</span><span>${new Date(tx.attributes.settledAt).toLocaleString()}</span></div>`);
        }

        if (tx.attributes.status === 'HELD') {
          rows.push(`<div class="panel-row"><span class="panel-label">Status</span><span class="status-badge status-held">Pending</span></div>`);
        }

        if (categoryName) {
          rows.push(`<div class="panel-row"><span class="panel-label">Category</span><span>${categoryName}</span></div>`);
        }

        if (tx.attributes.cardPurchaseMethod) {
          rows.push(`<div class="panel-row"><span class="panel-label">Method</span><span>${tx.attributes.cardPurchaseMethod.method.replace(/_/g,' ').toLowerCase()}</span></div>`);
        }

        if (tx.attributes.foreignAmount) {
          rows.push(`<div class="panel-row"><span class="panel-label">Foreign amount</span><span>${tx.attributes.foreignAmount.value} ${tx.attributes.foreignAmount.currencyCode}</span></div>`);
        }

        if (tx.attributes.holdInfo) {
          rows.push(`<div class="panel-row"><span class="panel-label">Original hold</span><span>$${fmt(Math.abs(tx.attributes.holdInfo.amount.value))}</span></div>`);
        }

        if (tx.attributes.roundUp) {
          rows.push(`<div class="panel-row"><span class="panel-label">Round-up</span><span>$${fmt(Math.abs(tx.attributes.roundUp.amount.value))}</span></div>`);
        }

        if (tx.attributes.cashback) {
          rows.push(`<div class="panel-row"><span class="panel-label">Cashback</span><span style="color:var(--green)">+$${fmt(tx.attributes.cashback.amount.value)}</span></div>`);
        }

        if (tx.attributes.rawText && tx.attributes.rawText !== tx.attributes.description) {
          rows.push(`<div class="panel-row"><span class="panel-label">Sender name</span><span>${tx.attributes.rawText}</span></div>`);
        }

        const tagsHtml = tags.length
          ? `<div class="panel-tags">${tags.map(t => `<span class="tag-chip">${t}</span>`).join('')}</div>`
          : '';

        panelContent.innerHTML = `
          <div class="panel-tx-header">
            <div>
              <p class="panel-tx-desc">${tx.attributes.description}</p>
              ${tx.attributes.message ? `<small class="panel-tx-msg">${tx.attributes.message}</small>` : ''}
            </div>
            <div class="panel-tx-amount ${tx.attributes.amount.value.startsWith('-') ? 'debit' : 'credit'}">${amountText}</div>
          </div>
          <hr />
          ${rows.join('<hr />')}
          ${tagsHtml}
        `;

        transactionDetailsPanel.classList.add('open');
      }

      // ── account card clicks ───────────────────────────────────────────────

      accountCards.forEach(card => {
        card.addEventListener('click', async () => {
          const accountId = card.dataset.accountId;
          currentAccountId = accountId;
          currentAccountName = card.querySelector('.card-name').textContent;
          currentAccountIsJoint = card.dataset.ownership === 'JOINT';

          accountCards.forEach(c => c.classList.remove('selected'));
          if (isBlurred) {
            accountCards.forEach(c => c.querySelector('.balance-amount').classList.add('blurred'));
          }
          card.classList.add('selected');
          card.querySelector('.balance-amount').classList.remove('blurred');

          transactionsHeading.textContent = currentAccountName;
          await fetchAndRenderTransactions(accountId, currentFilters());
        });
      });

      // ── load more ─────────────────────────────────────────────────────────

      loadMoreBtn.addEventListener('click', async () => {
        if (!nextPageCursor) return;
        loadMoreBtn.textContent = 'Loading…';
        loadMoreBtn.disabled = true;

        const response = await fetch(`/api/transactions/next?cursor=${encodeURIComponent(nextPageCursor)}`);
        if (handleFetchError(response)) return;
        const data = await response.json();

        transactionsData = transactionsData.concat(data.transactions);
        nextPageCursor = data.nextPage || null;

        data.transactions.forEach(tx => {
          const txDate = new Date(tx.attributes.createdAt).toDateString();
          const headers = transactionList.querySelectorAll('.transaction-date-header');
          const lastHeader = headers[headers.length - 1];
          if (!lastHeader || lastHeader.textContent !== txDate) {
            const header = document.createElement('div');
            header.classList.add('transaction-date-header');
            header.textContent = txDate;
            transactionList.appendChild(header);
          }
          transactionList.appendChild(buildTransactionItem(tx));
        });

        loadMoreBtn.textContent = 'Load more';
        loadMoreBtn.disabled = false;
        loadMoreContainer.style.display = nextPageCursor ? 'block' : 'none';
      });

      // ── filters ───────────────────────────────────────────────────────────

      function currentFilters() {
        return {
          status: document.getElementById('filter-status').value,
          since:  document.getElementById('filter-since').value,
          until:  document.getElementById('filter-until').value,
        };
      }

      document.getElementById('apply-filters-btn').addEventListener('click', async () => {
        if (currentAccountId) {
          transactionsHeading.textContent = currentAccountName;
          await fetchAndRenderTransactions(currentAccountId, currentFilters());
        }
      });

      document.getElementById('clear-filters-btn').addEventListener('click', async () => {
        document.getElementById('filter-status').value = '';
        document.getElementById('filter-since').value = '';
        document.getElementById('filter-until').value = '';
        if (currentAccountId) await fetchAndRenderTransactions(currentAccountId, {});
      });

      // ── toast ─────────────────────────────────────────────────────────────

      const toastContainer = document.getElementById('toast-container');

      function showToast(label, description, amount) {
        const toast = document.createElement('div');
        toast.classList.add('toast');

        if (description) {
          const top = document.createElement('div');
          top.classList.add('toast-label');
          top.textContent = label;

          const bottom = document.createElement('div');
          bottom.classList.add('toast-detail');
          const debit = amount && amount.startsWith('-');
          bottom.innerHTML = `<span>${description}</span><span class="toast-amount ${debit ? 'debit' : 'credit'}">${amount ? (debit ? `-$${fmt(amount.substring(1))}` : `+$${fmt(amount)}`) : ''}</span>`;

          toast.appendChild(top);
          toast.appendChild(bottom);
        } else {
          toast.textContent = label;
        }

        toastContainer.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 80);

        const dismiss = () => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 280);
        };
        setTimeout(dismiss, 4000);
        toast.addEventListener('click', dismiss);
      }

      // ── balance refresh ────────────────────────────────────────────────────

      async function refreshBalances() {
        const response = await fetch('/api/accounts');
        if (handleFetchError(response)) return;
        const { accounts } = await response.json();
        accounts.forEach(account => {
          const card = document.querySelector(`.card[data-account-id="${account.id}"]`);
          if (card) {
            card.querySelector('.balance-amount').textContent =
              parseFloat(account.attributes.balance.value).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          }
        });
      }

      // ── webhook event polling ─────────────────────────────────────────────

      const RELOAD_EVENTS = new Set([
        'TRANSACTION_CREATED', 'TRANSACTION_SETTLED',
        'TRANSACTION_DELETED', 'TRANSACTION_CATEGORY_CHANGE', 'TRANSACTION_NOTE_CHANGE',
      ]);

      const EVENT_LABELS = {
        TRANSACTION_CREATED:         'New transaction',
        TRANSACTION_SETTLED:         'Transaction settled',
        TRANSACTION_DELETED:         'Transaction deleted',
        TRANSACTION_CATEGORY_CHANGE: 'Category updated',
        TRANSACTION_NOTE_CHANGE:     'Note updated',
      };

      setInterval(async () => {
        const response = await fetch('/api/events');
        if (handleFetchError(response)) return;
        const { events } = await response.json();
        for (const event of events) {
          const label = EVENT_LABELS[event.type] || event.type.replace(/_/g,' ').toLowerCase().replace(/^\w/, c => c.toUpperCase());
          showToast(label, event.description, event.amount);
          if (RELOAD_EVENTS.has(event.type) && currentAccountId) {
            await Promise.all([
              fetchAndRenderTransactions(currentAccountId, currentFilters()),
              refreshBalances(),
            ]);
          }
        }
      }, 5000);

      // ── balance blur ──────────────────────────────────────────────────────

      const balanceToggleBtn = document.getElementById('balance-toggle-btn');
      const eyeOpenIcon  = document.getElementById('eye-open');
      const eyeClosedIcon = document.getElementById('eye-closed');
      let isBlurred = false;

      eyeOpenIcon.style.display  = 'none';
      eyeClosedIcon.style.display = 'block';

      balanceToggleBtn.addEventListener('click', () => {
        isBlurred = !isBlurred;
        document.querySelectorAll('.balance-amount').forEach(s => s.classList.toggle('blurred', isBlurred));
        eyeOpenIcon.style.display   = isBlurred ? 'block' : 'none';
        eyeClosedIcon.style.display = isBlurred ? 'none'  : 'block';
      });

      // ── close panel ───────────────────────────────────────────────────────

      document.addEventListener('click', event => {
        if (!transactionDetailsPanel.contains(event.target) && !event.target.closest('.transaction-item')) {
          transactionDetailsPanel.classList.remove('open');
        }
      });
    });
  </script>
</body>
</html>
